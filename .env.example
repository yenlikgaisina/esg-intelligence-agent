# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Tavily web-search API key (free tier available) — https://tavily.com/
TAVILY_API_KEY=tvly-...

# ---- Optional overrides ----
# ESG_MODEL=gemini-2.5-pro           # default is gemini-2.5-flash
# ESG_FOCUS_REGION=Kazakhstan + global
# ESG_MAX_STEPS=30

# Optional: enables the secondary OpenAI cross-check model (see config.py)
# OPENAI_API_KEY=sk-...
